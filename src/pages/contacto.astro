---
import { CheckCircle2, Sparkles } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { contactLinks } from "../data/site.js";
---

<BaseLayout title="Contacto | ASTL Technology Consulting">
  <SiteHeader />
  <main class="min-h-screen bg-ink pt-28 text-white">
    <section class="mx-auto grid max-w-7xl gap-10 px-5 py-12 md:grid-cols-[1fr_0.8fr] md:px-8 md:py-20">
      <div class="reveal">
        <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-teal/25 bg-teal/10 text-teal">
          <Sparkles size={24} aria-hidden="true" />
        </div>
        <h1 class="mt-6 text-4xl font-extrabold tracking-normal md:text-6xl">Hablemos de lo que tu negocio necesita resolver.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/64">
          Podemos empezar con una asesoría para revisar equipos, procesos, ventas, respaldos o una herramienta digital específica. La atención puede ser en línea o presencial según el servicio.
        </p>
      </div>
      <div class="reveal rounded-[1.75rem] border border-teal/18 bg-white/[0.04] p-7 shadow-soft">
        <div class="flex items-center gap-3 text-teal">
          <CheckCircle2 size={22} aria-hidden="true" />
          <span class="code-font font-bold">consulta.ready</span>
        </div>
        <div class="mt-6 space-y-3 rounded-2xl border border-teal/14 bg-ink/45 p-4">
          <p class="code-font text-sm text-white/72">email: astlteccons@gmail.com</p>
          <p class="code-font text-sm text-white/72">horario: lunes a sábado, 9:00 - 5:30</p>
          <p class="code-font text-sm text-white/72">modalidad: en línea + presencial</p>
        </div>
        <a href={contactLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="code-font mt-8 inline-flex w-full items-center justify-center gap-2 rounded-full bg-teal px-6 py-4 font-bold text-ink shadow-soft transition hover:bg-brass">
          <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
            <path d="M12.04 2a9.86 9.86 0 0 0-8.42 14.99L2.5 22l5.16-1.08A9.86 9.86 0 1 0 12.04 2Zm0 1.9a7.96 7.96 0 0 1 6.75 12.18 7.95 7.95 0 0 1-10.78 2.83l-.34-.2-2.72.57.59-2.64-.23-.36A7.96 7.96 0 0 1 12.04 3.9Zm-3.3 3.93c-.17 0-.45.06-.69.33-.24.26-.9.88-.9 2.15s.92 2.5 1.05 2.67c.13.17 1.79 2.86 4.48 3.9 2.24.88 2.69.7 3.17.66.49-.04 1.57-.64 1.79-1.26.22-.62.22-1.15.15-1.26-.07-.11-.24-.17-.51-.31-.26-.13-1.57-.78-1.81-.86-.24-.09-.42-.13-.6.13-.17.26-.68.86-.83 1.03-.15.18-.31.2-.57.07-.26-.13-1.11-.41-2.11-1.3-.78-.7-1.31-1.56-1.47-1.82-.15-.27-.02-.41.12-.54.12-.12.26-.31.4-.46.13-.16.17-.27.26-.44.09-.18.04-.33-.02-.46-.07-.13-.6-1.45-.82-1.98-.21-.5-.43-.43-.6-.44h-.5Z"></path>
          </svg>
          WhatsApp: 276 111 2578
        </a>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <a href={contactLinks.email} class="code-font inline-flex items-center justify-center gap-2 rounded-full border border-teal/25 bg-white/[0.04] px-5 py-3 font-bold text-teal transition hover:bg-teal/10">
            <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#EA4335" d="M12 13.2 3 6.75V18a1.5 1.5 0 0 0 1.5 1.5h15A1.5 1.5 0 0 0 21 18V6.75l-9 6.45Z"></path>
              <path fill="#FBBC04" d="M21 6.75V6a1.5 1.5 0 0 0-2.4-1.2L12 9.6l9 6.45v-9.3Z"></path>
              <path fill="#34A853" d="M3 6.75V16.05L12 9.6 5.4 4.8A1.5 1.5 0 0 0 3 6Z"></path>
              <path fill="#4285F4" d="m12 13.2 6.6-4.8V4.8L12 9.6 5.4 4.8v3.6l6.6 4.8Z"></path>
            </svg>
            Correo
          </a>
          <a href={contactLinks.facebook} target="_blank" rel="noopener noreferrer" class="code-font inline-flex items-center justify-center gap-2 rounded-full border border-teal/25 bg-white/[0.04] px-5 py-3 font-bold text-teal transition hover:bg-teal/10">
            <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="#1877F2">
              <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.438H7.078v-3.49h3.047V9.414c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.49 0-1.956.93-1.956 1.887v2.263h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"></path>
            </svg>
            Facebook
          </a>
          <a href={contactLinks.instagram} target="_blank" rel="noopener noreferrer" class="code-font inline-flex items-center justify-center gap-2 rounded-full border border-teal/25 bg-white/[0.04] px-5 py-3 font-bold text-teal transition hover:bg-teal/10">
            <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="instagram-gradient" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#FEDA75"></stop>
                  <stop offset=".25" stop-color="#FA7E1E"></stop>
                  <stop offset=".5" stop-color="#D62976"></stop>
                  <stop offset=".75" stop-color="#962FBF"></stop>
                  <stop offset="1" stop-color="#4F5BD5"></stop>
                </linearGradient>
              </defs>
              <path fill="url(#instagram-gradient)" d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-2.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z"></path>
            </svg>
            Instagram
          </a>
        </div>
      </div>
    </section>
  </main>
  <FloatingWhatsApp />
  <SiteFooter />
</BaseLayout>
