---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FloatingWhatsApp from "../../../components/FloatingWhatsApp.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { clients } from "../../../data/site.js";
import logoPaleteria from "./logo-paleteria.png";
import productosTicket from "./assets-pv/01-productos-ticket.png";
import nuevoProducto from "./assets-pv/02-nuevo-producto.png";
import materiaPrima from "./assets-pv/03-materia-prima.png";
import nuevaMateriaPrima from "./assets-pv/04-nueva-materia-prima.png";
import clientes from "./assets-pv/05-clientes.png";
import nuevoCliente from "./assets-pv/06-nuevo-cliente.png";
import pedidos from "./assets-pv/07-pedidos.png";
import nuevoPedido from "./assets-pv/08-nuevo-pedido.png";
import ventas from "./assets-pv/09-ventas.png";
import corteCaja from "./assets-pv/10-corte-caja.png";
import proveedores from "./assets-pv/11-proveedores.png";
import configuracion from "./assets-pv/12-configuracion.png";

const client = clients.find((item) => item.slug === "paleteria-nopalucan");
const pvScreens = [
  [productosTicket, "Productos y ticket"],
  [nuevoProducto, "Nuevo producto"],
  [materiaPrima, "Materia prima"],
  [nuevaMateriaPrima, "Nueva materia prima"],
  [clientes, "Clientes"],
  [nuevoCliente, "Nuevo cliente"],
  [pedidos, "Pedidos"],
  [nuevoPedido, "Nuevo pedido"],
  [ventas, "Ventas"],
  [corteCaja, "Corte de caja"],
  [proveedores, "Proveedores"],
  [configuracion, "Configuración"]
];
---

<BaseLayout title={`${client.name} | Proyectos ASTL`}>
  <SiteHeader />
  <main class="min-h-screen bg-ink pt-28 text-white">
    <section class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-20">
      <div class="reveal grid gap-8 md:grid-cols-[0.82fr_1.18fr] md:items-end">
        <div>
          <a href="/proyectos/" class="code-font text-sm font-bold uppercase tracking-[0.2em] text-teal transition hover:text-brass">
            projects.back
          </a>
          <div class="mt-6 flex items-center gap-4">
            <img
              src={logoPaleteria.src}
              width={logoPaleteria.width}
              height={logoPaleteria.height}
              alt={`Logo de ${client.name}`}
              class="h-20 w-20 rounded-2xl border border-teal/20 bg-white object-contain p-2 shadow-soft"
            />
            <h1 class="text-4xl font-extrabold tracking-normal md:text-6xl">{client.name}</h1>
          </div>
        </div>
        <p class="text-lg leading-8 text-white/62">
          Carpeta del cliente con los trabajos realizados y entregados por ASTL Technology Consulting.
        </p>
      </div>

      <div class="reveal mt-12 overflow-hidden rounded-[1.75rem] border border-teal/16 bg-ink/65 shadow-soft">
        <div class="grid gap-0 lg:grid-cols-[0.42fr_0.58fr]">
          <div class="border-b border-teal/12 p-7 lg:border-b-0 lg:border-r">
            <div class="code-font inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">
              preview_pv
            </div>
            <h2 class="mt-6 text-3xl font-extrabold">Punto de venta a la medida</h2>
            <p class="mt-4 leading-7 text-white/62">
              Vista rápida de las pantallas principales: productos, clientes, pedidos, ventas, corte de caja, proveedores y configuración.
            </p>
            <div class="mt-7 grid grid-cols-2 gap-3">
              {["Ventas", "Pedidos", "Clientes", "Caja"].map((module) => (
                <div class="rounded-2xl border border-teal/12 bg-white/[0.04] px-4 py-3">
                  <p class="code-font text-xs font-bold uppercase text-brass">{module}</p>
                  <p class="mt-1 text-sm text-white/54">módulo activo</p>
                </div>
              ))}
            </div>
          </div>

          <div class="pv-showcase relative h-[560px] overflow-hidden bg-white/[0.03] p-5 md:h-[620px]">
            <div class="absolute left-5 right-5 top-5 z-10 flex items-center justify-between rounded-2xl border border-teal/12 bg-ink/86 px-4 py-3 backdrop-blur">
              <span class="code-font text-xs font-bold text-teal">assets-pv.running</span>
              <span class="code-font text-xs font-bold text-brass">{pvScreens.length} vistas</span>
            </div>
            <div class="pv-track pt-16">
              {[...pvScreens, ...pvScreens].map(([screen, label]) => (
                <figure class="mb-5 overflow-hidden rounded-2xl border border-teal/14 bg-ink shadow-soft">
                  <img
                    src={screen.src}
                    width={screen.width}
                    height={screen.height}
                    alt={`Pantalla del punto de venta: ${label}`}
                    class="aspect-[16/10] w-full object-cover object-top"
                    loading="lazy"
                  />
                  <figcaption class="border-t border-teal/12 px-4 py-3 text-sm font-semibold text-white/72">
                    {label}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {client.projects.map((project, index) => (
          <article class="reveal rounded-[1.75rem] border border-teal/16 bg-ink/65 p-7 shadow-soft">
            <div class="code-font inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">
              {project.code}
            </div>
            <h2 class="mt-6 text-2xl font-extrabold">{project.title}</h2>
            <p class="mt-3 leading-7 text-white/62">{project.text}</p>
            <p class="code-font mt-6 text-sm text-brass">
              {index === 0 ? "status: entregado / visual disponible" : "status: entregado / visual pendiente"}
            </p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <FloatingWhatsApp />
  <SiteFooter />
</BaseLayout>

<style>
  .pv-showcase::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 120px;
    background: linear-gradient(180deg, rgba(5, 7, 12, 0), #05070c 86%);
    content: "";
    pointer-events: none;
  }

  .pv-track {
    animation: pv-scroll 34s linear infinite;
  }

  .pv-showcase:hover .pv-track {
    animation-play-state: paused;
  }

  @keyframes pv-scroll {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-track {
      animation: none;
    }
  }
</style>
