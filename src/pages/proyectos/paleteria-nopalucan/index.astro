---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FloatingWhatsApp from "../../../components/FloatingWhatsApp.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import { clients } from "../../../data/site.js";
import logoPaleteria from "./logo-paleteria.png";
import productosTicket from "./assets-pv/01-productos-ticket.png";

const client = clients.find((item) => item.slug === "paleteria-nopalucan");
const pvScreens = [
  [productosTicket, "Productos y ticket"]
];
const previewPvScreens = pvScreens.length > 1 ? [...pvScreens, ...pvScreens] : pvScreens;
const pvStatusLabel = pvScreens.length === 1 ? "1 vista" : `${pvScreens.length} vistas`;
---

<BaseLayout title={`${client.name} | Proyectos ASTL`}>
  <SiteHeader />
  <main class="min-h-screen bg-ink pt-20 text-white">
    <section class="mx-auto max-w-7xl px-5 pb-8 pt-5 md:px-8 md:pb-12 md:pt-6">
      <div class="reveal grid gap-8 md:grid-cols-[0.82fr_1.18fr] md:items-end">
        <div>
          <a href="/proyectos/" class="code-font text-sm font-bold uppercase tracking-[0.2em] text-teal transition hover:text-brass">
            projects.back
          </a>
          <div class="mt-6 flex items-center gap-4">
            <img
              src={logoPaleteria.src}
              width={logoPaleteria.width}
              height={logoPaleteria.height}
              alt={`Logo de ${client.name}`}
              class="h-20 w-20 rounded-2xl border border-teal/20 bg-white object-contain p-2 shadow-soft"
            />
            <h1 class="text-4xl font-extrabold tracking-normal md:text-6xl">{client.name}</h1>
          </div>
        </div>
        <p class="text-lg leading-8 text-white/62">
          Registro de soluciones desarrolladas para fortalecer la operación comercial y la presencia digital del negocio.
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-2">
        <article class="reveal overflow-hidden rounded-[1.75rem] border border-teal/16 bg-ink/65 shadow-soft">
          <div class="border-b border-teal/12 p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="code-font inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">
                preview_pv
              </div>
              <span class="code-font rounded-full bg-brass/10 px-3 py-1 text-xs font-bold text-brass">
                {pvStatusLabel}
              </span>
            </div>
            <h2 class="mt-5 text-2xl font-extrabold">Punto de venta a la medida</h2>
            <p class="mt-3 leading-7 text-white/62">
              Sistema orientado al registro de ventas, selección de productos y generación de ticket dentro de un flujo de atención claro.
            </p>
          </div>

          <div class="pv-showcase relative h-[380px] overflow-hidden bg-white/[0.03] p-4 md:h-[430px]">
            <div class="absolute left-4 right-4 top-4 z-10 flex items-center justify-between rounded-2xl border border-teal/12 bg-ink/86 px-4 py-3 backdrop-blur">
              <span class="code-font text-xs font-bold text-teal">assets-pv.running</span>
              <span class="code-font text-xs font-bold text-brass">entregado</span>
            </div>
            <div class={`pv-track pt-14 ${pvScreens.length === 1 ? "pv-track-static" : ""}`}>
              {previewPvScreens.map(([screen, label]) => (
                <figure class="mb-4 overflow-hidden rounded-2xl border border-teal/14 bg-ink shadow-soft">
                  <img
                    src={screen.src}
                    width={screen.width}
                    height={screen.height}
                    alt={`Pantalla del punto de venta: ${label}`}
                    class="aspect-[16/9] w-full object-cover object-top"
                    loading="lazy"
                  />
                  <figcaption class="border-t border-teal/12 px-4 py-2 text-sm font-semibold text-white/72">
                    {label}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </article>

        <article class="reveal overflow-hidden rounded-[1.75rem] border border-teal/16 bg-ink/65 shadow-soft">
          <div class="border-b border-teal/12 p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="code-font inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">
                preview_web
              </div>
              <span class="code-font rounded-full bg-brass/10 px-3 py-1 text-xs font-bold text-brass">
                pendiente
              </span>
            </div>
            <h2 class="mt-5 text-2xl font-extrabold">Página web</h2>
            <p class="mt-3 leading-7 text-white/62">
              Sitio creado para presentar la identidad del negocio, sus productos y canales de contacto en una experiencia web directa.
            </p>
          </div>

          <div class="relative flex h-[380px] items-center justify-center overflow-hidden bg-white/[0.03] p-4 md:h-[430px]">
            <div class="w-full max-w-md rounded-2xl border border-dashed border-teal/28 bg-ink/70 p-6 text-center">
              <div class="code-font mx-auto inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">
                preview en preparación
              </div>
              <div class="mt-6 space-y-3">
                <div class="mx-auto h-3 w-3/4 rounded-full bg-teal/18"></div>
                <div class="mx-auto h-3 w-1/2 rounded-full bg-brass/18"></div>
                <div class="mx-auto h-28 w-full rounded-2xl border border-teal/12 bg-white/[0.04]"></div>
              </div>
              <p class="mt-6 text-sm leading-6 text-white/54">
                La galería visual de este proyecto se mostrará en este espacio cuando el material esté integrado.
              </p>
            </div>
          </div>
        </article>
      </div>
    </section>
  </main>
  <FloatingWhatsApp />
  <SiteFooter />
</BaseLayout>

<style>
  .pv-showcase::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 90px;
    background: linear-gradient(180deg, rgba(5, 7, 12, 0), #05070c 86%);
    content: "";
    pointer-events: none;
  }

  .pv-track {
    animation: pv-scroll 32s linear infinite;
  }

  .pv-track-static {
    animation: none;
  }

  .pv-track-static figure {
    margin-bottom: 0;
  }

  .pv-showcase:hover .pv-track {
    animation-play-state: paused;
  }

  @keyframes pv-scroll {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-track {
      animation: none;
    }
  }
</style>
