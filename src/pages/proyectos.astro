---
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { projects } from "../data/site.js";
---

<BaseLayout title="Proyectos | ASTL Technology Consulting">
  <SiteHeader />
  <main class="min-h-screen bg-ink pt-28 text-white">
    <section class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-20">
      <div class="reveal grid gap-8 md:grid-cols-[0.78fr_1.22fr] md:items-end">
        <div>
          <p class="code-font text-sm font-bold uppercase tracking-[0.2em] text-teal">projects.log</p>
          <h1 class="mt-4 text-4xl font-extrabold tracking-normal md:text-6xl">Proyectos realizados.</h1>
        </div>
        <p class="text-lg leading-8 text-white/62">
          Trabajos entregados que muestran soluciones reales desarrolladas para clientes.
        </p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {projects.map(([code, title, text]) => (
          <article class="reveal rounded-[1.75rem] border border-teal/16 bg-ink/65 p-7 shadow-soft">
            <div class="code-font inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">{code}</div>
            <h2 class="mt-6 text-2xl font-extrabold">{title}</h2>
            <p class="mt-3 leading-7 text-white/62">{text}</p>
            <p class="code-font mt-6 text-sm text-brass">status: entregado</p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <FloatingWhatsApp />
  <SiteFooter />
</BaseLayout>
