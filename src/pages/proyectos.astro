---
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { clients } from "../data/site.js";
---

<BaseLayout title="Proyectos | ASTL Technology Consulting">
  <SiteHeader />
  <main class="min-h-screen bg-ink pt-28 text-white">
    <section class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-20">
      <div class="reveal grid gap-8 md:grid-cols-[0.78fr_1.22fr] md:items-end">
        <div>
          <p class="code-font text-sm font-bold uppercase tracking-[0.2em] text-teal">projects.log</p>
          <h1 class="mt-4 text-4xl font-extrabold tracking-normal md:text-6xl">Proyectos realizados.</h1>
        </div>
        <p class="text-lg leading-8 text-white/62">
          Trabajos entregados que muestran soluciones reales desarrolladas para clientes.
        </p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {clients.map((client) => (
          <a
            href={client.href}
            class="reveal group block rounded-[1.75rem] border border-teal/16 bg-ink/65 p-7 shadow-soft transition hover:-translate-y-1 hover:border-teal/45"
          >
            <div class="flex items-start justify-between gap-5">
              <div class="code-font inline-flex rounded-full border border-teal/20 bg-teal/8 px-3 py-1 text-xs font-bold text-teal">
                {client.code}
              </div>
              <span class="code-font rounded-full bg-brass/10 px-3 py-1 text-xs font-bold text-brass">
                {client.projects.length} proyectos
              </span>
            </div>
            <h2 class="mt-6 text-2xl font-extrabold transition group-hover:text-teal">{client.name}</h2>
            <p class="mt-3 leading-7 text-white/62">{client.summary}</p>
            <p class="code-font mt-6 text-sm text-brass">abrir carpeta del cliente</p>
          </a>
        ))}
      </div>
    </section>
  </main>
  <FloatingWhatsApp />
  <SiteFooter />
</BaseLayout>
