---
import { CheckCircle2 } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { packages } from "../data/site.js";
---

<BaseLayout title="Paquetes | ASTL Technology Consulting">
  <SiteHeader />
  <main class="min-h-screen bg-ink pt-28 text-white">
    <section class="mx-auto max-w-7xl px-5 py-12 md:px-8 md:py-20">
      <div class="reveal max-w-3xl">
        <p class="code-font text-sm font-bold uppercase tracking-[0.2em] text-ember">plans.config</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-normal md:text-6xl">Paquetes flexibles para empezar con orden.</h1>
        <p class="mt-5 text-lg leading-8 text-white/62">
          No son precios cerrados; son rutas de trabajo para elegir el alcance correcto antes de invertir en tecnología.
        </p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {packages.map((pack) => (
          <article class="reveal rounded-[1.75rem] border border-teal/16 bg-white/[0.04] p-7 shadow-soft transition hover:-translate-y-1 hover:border-teal/45">
            <p class="code-font text-sm font-bold text-teal">{pack.label}</p>
            <h2 class="mt-3 text-3xl font-extrabold">{pack.name}</h2>
            <p class="mt-4 min-h-24 leading-7 text-white/62">{pack.description}</p>
            <ul class="mt-7 space-y-4">
              {pack.items.map((item) => (
                <li class="flex gap-3 text-white/72">
                  <CheckCircle2 class="mt-1 shrink-0 text-teal" size={18} aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
  <FloatingWhatsApp />
  <SiteFooter />
</BaseLayout>
